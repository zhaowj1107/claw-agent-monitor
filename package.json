{
  "name": "claw-agent-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "Web dashboard for monitoring OpenClaw sub-agents in real-time",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc --project tsconfig.server.json",
    "build:web": "cd web && npm run build",
    "start:server": "node dist/server/index.js",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "cd web && npm run dev",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Weijian Zhao",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
